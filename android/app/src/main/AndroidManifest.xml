<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          Real AdMob App ID - required for the AdMob SDK to initialize at
          all (its absence crashes the app on launch, not just "no ads").
          Ad requests still serve TEST ads for now (see student-web's
          lib/admob.ts IS_TESTING flag) - flip that to false once ready to
          actually launch with real ad serving.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3017457917940987~5242228476" />

        <!-- Default icon/color FCM uses for a notification shown while the
             app isn't open (no in-app code runs then to style it) - without
             this it falls back to a poorly-scaled app icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by Google Play Billing (native-purchases plugin). -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Required on Android 13+ to actually show a push notification -
         @capacitor/push-notifications doesn't declare this itself, the app
         has to. Still requested at runtime too (see lib/push-notifications.ts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
